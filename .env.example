# ---------------------------------------------------------------------------
# Copy to .env and fill in. .env is gitignored - never commit a real key.
# ---------------------------------------------------------------------------

# LLM provider: "gemini" or "mock".
# If this is "gemini" but GEMINI_API_KEY is empty, the service automatically
# falls back to the deterministic mock provider and says so at startup.
LLM_PROVIDER=gemini

# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Any current Gemini model. Flash is the right default here: tool routing and
# short factual summaries do not need a frontier model.
GEMINI_MODEL=gemini-3.6-flash

# Low temperature - this is a factual reporting task, not a creative one.
LLM_TEMPERATURE=0.2

# --- server ---
PORT=3000
NODE_ENV=development

# --- agent guardrails ---
AGENT_MAX_TOOL_ROUNDS=5
AGENT_TIMEOUT_MS=90000

# --- api ---
# Return the tool-call trace with each answer. On by default for auditability.
EXPOSE_TRACE=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60
